<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crop Planner - AgroVision</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    <style>
        /* Hero Section */
        .planner-hero {
            background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
            color: white;
            padding: 3rem 2rem;
            border-radius: 8px;
            margin-bottom: 3rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .planner-hero h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .planner-hero p {
            font-size: 1.1rem;
            opacity: 0.95;
        }

        /* Crop Cards Grid */
        .crop-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .crop-card {
            background: white;
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 3px solid transparent;
        }

        .crop-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            border-color: var(--primary-color);
        }

        .crop-card-icon {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }

        .crop-card h3 {
            font-size: 1.2rem;
            margin: 1rem 0 0.5rem;
            color: var(--text-color);
        }

        .crop-card p {
            font-size: 0.9rem;
            color: #7f8c8d;
            margin: 0;
        }

        /* Enhanced Planner Container */
        .planner-form-section {
            background: white;
            padding: 2.5rem;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 3rem;
        }

        .planner-form-section h2 {
            color: var(--primary-color);
            margin-bottom: 2rem;
            font-size: 1.8rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .form-grid .form-group {
            margin-bottom: 0;
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Timeline Enhancement */
        .schedule-card {
            background: white;
            padding: 2.5rem;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-top: 3rem;
        }

        .schedule-card h2 {
            color: var(--primary-color);
            margin-bottom: 2rem;
            font-size: 1.8rem;
        }

        .timeline {
            position: relative;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 30px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, var(--primary-color), var(--secondary-color));
        }

        .timeline-item {
            margin-bottom: 2.5rem;
            padding-left: 100px;
            position: relative;
        }

        .timeline-marker {
            position: absolute;
            left: 10px;
            top: 5px;
            width: 40px;
            height: 40px;
            background: white;
            border: 3px solid var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .timeline-marker::after {
            content: '';
            width: 12px;
            height: 12px;
            background: var(--primary-color);
            border-radius: 50%;
        }

        .timeline-content {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 6px;
            border-left: 4px solid var(--primary-color);
        }

        .timeline-content h3 {
            color: var(--primary-color);
            margin: 0 0 0.5rem 0;
            font-size: 1.2rem;
        }

        .timeline-content p {
            margin: 0.5rem 0;
            color: #555;
        }

        /* Information Cards */
        .crop-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .crop-info-card {
            background: white;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            border-top: 4px solid var(--primary-color);
        }

        .crop-info-card h4 {
            color: var(--primary-color);
            margin-top: 0;
        }

        .crop-info-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .crop-info-card li {
            padding: 0.5rem 0;
            color: #555;
            border-bottom: 1px solid #ecf0f1;
        }

        .crop-info-card li:last-child {
            border-bottom: none;
        }

        /* Features Section */
        .features-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #ecf0f1 100%);
            padding: 2rem;
            border-radius: 8px;
            margin-bottom: 3rem;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .feature-item {
            text-align: center;
            padding: 1.5rem;
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }

        .feature-item h4 {
            color: var(--text-color);
            margin: 0.5rem 0;
        }

        .feature-item p {
            color: #7f8c8d;
            margin: 0;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmers" class="nav-link">Farmers</a></li>
            <li><a href="/contractors" class="nav-link">Contractors</a></li>
            <li><a href="/revenue" class="nav-link">Revenue</a></li>
            <li><a href="/planner" class="nav-link active">Planner</a></li>
        </ul>
    </nav>

    <div class="container">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <!-- Hero Section -->
        <div class="planner-hero">
            <h2><i class="fas fa-calendar-alt"></i> Crop Planner</h2>
            <p>Create detailed seasonal plans for your crops and optimize your farming schedule</p>
        </div>

        <!-- Features Section -->
        <div class="features-section">
            <h3 style="text-align: center; margin-top: 0; color: var(--text-color);">Why Use Our Crop Planner?</h3>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                    <h4>Optimize Yields</h4>
                    <p>Maximize your crop productivity with data-driven insights</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-calendar-check"></i></div>
                    <h4>Perfect Timing</h4>
                    <p>Plan activities at the optimal time for each growth stage</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-water"></i></div>
                    <h4>Resource Planning</h4>
                    <p>Efficiently manage water, fertilizers, and pest control</p>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-leaf"></i></div>
                    <h4>Crop Health</h4>
                    <p>Monitor and maintain optimal crop health throughout the season</p>
                </div>
            </div>
        </div>

        <!-- Crop Types Section -->
        <h3 style="margin-bottom: 1.5rem; color: var(--text-color);"><i class="fas fa-seedling"></i> Select Your Crop Type</h3>
        <div class="crop-cards-grid">
            <div class="crop-card" onclick="selectCrop('Wheat')">
                <div class="crop-card-icon">🌾</div>
                <h3>Wheat</h3>
                <p>Rabi Season Crop</p>
            </div>
            <div class="crop-card" onclick="selectCrop('Rice')">
                <div class="crop-card-icon">🍚</div>
                <h3>Rice</h3>
                <p>Kharif Season Crop</p>
            </div>
            <div class="crop-card" onclick="selectCrop('Maize')">
                <div class="crop-card-icon">🌽</div>
                <h3>Maize</h3>
                <p>Summer Crop</p>
            </div>
            <div class="crop-card" onclick="selectCrop('Cotton')">
                <div class="crop-card-icon">🏭</div>
                <h3>Cotton</h3>
                <p>Kharif Crop</p>
            </div>
            <div class="crop-card" onclick="selectCrop('Sugarcane')">
                <div class="crop-card-icon">🌱</div>
                <h3>Sugarcane</h3>
                <p>Long Duration Crop</p>
            </div>
            <div class="crop-card" onclick="selectCrop('Groundnut')">
                <div class="crop-card-icon">🥜</div>
                <h3>Groundnut</h3>
                <p>Summer Crop</p>
            </div>
        </div>

        <!-- Planner Form Section -->
        <div class="planner-form-section">
            <h2><i class="fas fa-edit"></i> Create Your Planting Schedule</h2>
            <form method="POST" action="/planner/generate" id="plannerForm">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="cropType"><i class="fas fa-leaf"></i> Crop Type *</label>
                        <select id="cropType" name="cropType" required>
                            <option value="">-- Select Crop --</option>
                            <option value="Wheat">Wheat</option>
                            <option value="Rice">Rice</option>
                            <option value="Maize">Maize</option>
                            <option value="Cotton">Cotton</option>
                            <option value="Sugarcane">Sugarcane</option>
                            <option value="Groundnut">Groundnut</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="sowingDate"><i class="fas fa-calendar-day"></i> Sowing Date *</label>
                        <input type="date" id="sowingDate" name="sowingDate" required>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 2rem;">
                    <label for="duration"><i class="fas fa-hourglass-half"></i> Expected Duration (Days) *</label>
                    <input type="number" id="duration" name="duration" required min="30" placeholder="Enter crop duration in days" style="max-width: 100%;">
                </div>

                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-magic"></i> Generate Plan
                </button>
            </form>
        </div>

        <!-- Crop Information Section -->
        <h3 style="margin-bottom: 1.5rem; margin-top: 3rem; color: var(--text-color);"><i class="fas fa-info-circle"></i> Crop Information Guide</h3>
        <div class="crop-info-grid">
            <div class="crop-info-card">
                <h4>🌾 Wheat</h4>
                <ul>
                    <li><strong>Season:</strong> Rabi (Oct-Mar)</li>
                    <li><strong>Duration:</strong> 120-150 days</li>
                    <li><strong>Water:</strong> 400-500 mm</li>
                    <li><strong>Yield:</strong> 40-50 q/ha</li>
                </ul>
            </div>
            <div class="crop-info-card">
                <h4>🍚 Rice</h4>
                <ul>
                    <li><strong>Season:</strong> Kharif (Jun-Oct)</li>
                    <li><strong>Duration:</strong> 90-150 days</li>
                    <li><strong>Water:</strong> 1000-1200 mm</li>
                    <li><strong>Yield:</strong> 30-60 q/ha</li>
                </ul>
            </div>
            <div class="crop-info-card">
                <h4>🌽 Maize</h4>
                <ul>
                    <li><strong>Season:</strong> Summer (Feb-Jun)</li>
                    <li><strong>Duration:</strong> 80-100 days</li>
                    <li><strong>Water:</strong> 500-600 mm</li>
                    <li><strong>Yield:</strong> 30-50 q/ha</li>
                </ul>
            </div>
            <div class="crop-info-card">
                <h4>🏭 Cotton</h4>
                <ul>
                    <li><strong>Season:</strong> Kharif (May-Oct)</li>
                    <li><strong>Duration:</strong> 180-210 days</li>
                    <li><strong>Water:</strong> 600-800 mm</li>
                    <li><strong>Yield:</strong> 10-20 q/ha</li>
                </ul>
            </div>
            <div class="crop-info-card">
                <h4>🌱 Sugarcane</h4>
                <ul>
                    <li><strong>Season:</strong> Year-round</li>
                    <li><strong>Duration:</strong> 300-360 days</li>
                    <li><strong>Water:</strong> 1500-2000 mm</li>
                    <li><strong>Yield:</strong> 600-800 q/ha</li>
                </ul>
            </div>
            <div class="crop-info-card">
                <h4>🥜 Groundnut</h4>
                <ul>
                    <li><strong>Season:</strong> Summer (Feb-Jun)</li>
                    <li><strong>Duration:</strong> 100-130 days</li>
                    <li><strong>Water:</strong> 500-600 mm</li>
                    <li><strong>Yield:</strong> 15-25 q/ha</li>
                </ul>
            </div>
        </div>

        <% if (typeof schedule !== 'undefined' && schedule && schedule.length > 0) { %>
            <div class="schedule-card">
                <h2><i class="fas fa-tasks"></i> Your Crop Schedule</h2>
                <div class="timeline">
                    <% schedule.forEach((event, index) => { %>
                        <div class="timeline-item">
                            <div class="timeline-marker"></div>
                            <div class="timeline-content">
                                <h3><i class="fas fa-check-circle"></i> <%= event.activity %></h3>
                                <p><strong>📅 Date:</strong> <%= event.date %></p>
                                <p><strong>⏱️ Day:</strong> <%= event.day %></p>
                                <% if (event.notes) { %>
                                    <p><strong>📝 Notes:</strong> <%= event.notes %></p>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>
    </div>

    <footer class="footer">
        <p>&copy; 2025 AgroVision - Agricultural Planning Platform</p>
    </footer>

    <script>
        function selectCrop(cropName) {
            document.getElementById('cropType').value = cropName;
            // Scroll to form
            document.querySelector('.planner-form-section').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
