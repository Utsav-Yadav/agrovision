<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    <style>
        .page-header { background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); color: white; padding: 2rem; border-radius: 8px; margin-bottom: 2rem; }
        .page-header h1 { margin: 0; font-size: 2rem; }
        .contract-card { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
        .status { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; font-weight: bold; }
        .status.pending { background: #fff3cd; color: #856404; }
        .status.accepted { background: #d4edda; color: #155724; }
        .status.completed { background: #d1ecf1; color: #0c5460; }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmer/profile" class="nav-link">Profile</a></li>
            <li><a href="/farmer/my-contracts" class="nav-link active">Contracts</a></li>
            <li><a href="/farmer/revenue-history" class="nav-link">Revenue</a></li>
            <li><a href="/farmer/logout" class="nav-link">Logout</a></li>
        </ul>
    </nav>
    <div class="container" style="margin-top: 2rem;">
        <div class="page-header">
            <h1>📜 My Contracts</h1>
            <p>All your signed contracts and applications</p>
        </div>

        <div style="margin-top: 2rem;">
            <h2>⏳ Pending Applications</h2>
            <% if (pendingApplications && pendingApplications.length > 0) { %>
                <% pendingApplications.forEach(contract => { %>
                    <div class="contract-card">
                        <strong><%= contract.contractorId?.name || 'Unknown Contractor' %></strong>
                        <p style="margin: 0.5rem 0;">Region: <%= contract.contractorId?.region || 'N/A' %></p>
                        <span class="status pending"><%= contract.status %></span>
                        <small style="color: #999; margin-left: 1rem;">Signed: <%= new Date(contract.applicationDate).toLocaleDateString() %></small>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: #7f8c8d;">No pending applications</p>
            <% } %>
        </div>

        <div style="margin-top: 2rem;">
            <h2>✅ Active Contracts</h2>
            <% if (activeApplications && activeApplications.length > 0) { %>
                <% activeApplications.forEach(contract => { %>
                    <div class="contract-card">
                        <strong><%= contract.contractorId?.name || 'Unknown Contractor' %></strong>
                        <p style="margin: 0.5rem 0;">Region: <%= contract.contractorId?.region || 'N/A' %></p>
                        <span class="status accepted"><%= contract.status %></span>
                        <small style="color: #999; margin-left: 1rem;">Active since: <%= new Date(contract.applicationDate).toLocaleDateString() %></small>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: #7f8c8d;">No active contracts</p>
            <% } %>
        </div>

        <div style="margin-top: 2rem;">
            <h2>🏁 Completed Contracts</h2>
            <% if (completedApplications && completedApplications.length > 0) { %>
                <% completedApplications.forEach(contract => { %>
                    <div class="contract-card">
                        <strong><%= contract.contractorId?.name || 'Unknown Contractor' %></strong>
                        <p style="margin: 0.5rem 0;">Region: <%= contract.contractorId?.region || 'N/A' %></p>
                        <span class="status completed"><%= contract.status %></span>
                        <small style="color: #999; margin-left: 1rem;">Completed: <%= new Date(contract.applicationDate).toLocaleDateString() %></small>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: #7f8c8d;">No completed contracts</p>
            <% } %>
        </div>
    </div>
</body>
</html>
