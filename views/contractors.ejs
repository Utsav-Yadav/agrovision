<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contractors - AgroVision</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmers" class="nav-link">Farmers</a></li>
            <li><a href="/contractors" class="nav-link active">Contractors</a></li>
            <li><a href="/revenue" class="nav-link">Revenue</a></li>
            <li><a href="/planner" class="nav-link">Planner</a></li>
        </ul>
    </nav>

    <div class="container">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <div class="page-header">
            <h1><i class="fas fa-hard-hat"></i> Contractors</h1>
            <button class="btn btn-primary" onclick="toggleForm()">+ Register New Contractor</button>
        </div>

        <div id="contractorForm" class="form-container" style="display: none;">
            <h2>Register New Contractor</h2>
            <form method="POST" action="/contractors/create">
                <div class="form-group">
                    <label for="name">Company Name *</label>
                    <input type="text" id="name" name="name" required placeholder="Enter company name">
                </div>
                <div class="form-group">
                    <label for="contact">Contact Number *</label>
                    <input type="text" id="contact" name="contact" required placeholder="Enter contact number">
                </div>
                <div class="form-group">
                    <label for="region">Region *</label>
                    <input type="text" id="region" name="region" required placeholder="Enter service region">
                </div>
                <div class="form-group">
                    <label for="requiredAcreageHa">Min Acreage Required (Ha) *</label>
                    <input type="number" id="requiredAcreageHa" name="requiredAcreageHa" required step="0.1" placeholder="Enter minimum acreage">
                </div>
                <div class="form-group">
                    <label for="crops">Crops Handled (comma-separated) *</label>
                    <input type="text" id="crops" name="crops" required placeholder="e.g., Wheat, Rice, Maize">
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Register</button>
                    <button type="button" class="btn btn-secondary" onclick="toggleForm()">Cancel</button>
                </div>
            </form>
        </div>

        <div class="list-section">
            <h2>Registered Contractors</h2>
            <% if (contractors && contractors.length > 0) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Company Name</th>
                            <th>Contact</th>
                            <th>Region</th>
                            <th>Min Acreage (Ha)</th>
                            <th>Crops</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% contractors.forEach(contractor => { %>
                            <tr>
                                <td><%= contractor.name %></td>
                                <td><%= contractor.contact || '-' %></td>
                                <td><%= contractor.region || '-' %></td>
                                <td><%= contractor.requiredAcreageHa || '-' %></td>
                                <td><%= contractor.crops ? contractor.crops.join(', ') : '-' %></td>
                                <td><%= new Date(contractor.createdAt).toLocaleDateString() %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="empty-state">No contractors registered yet. Be the first to register!</p>
            <% } %>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2025 AgroVision - Agricultural Planning Platform</p>
    </footer>

    <script>
        function toggleForm() {
            const form = document.getElementById('contractorForm');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    </script>
</body>
</html>
