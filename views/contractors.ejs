<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contractors - AgroVision</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmers" class="nav-link">Farmers</a></li>
            <li><a href="/contractors" class="nav-link active">Contractors</a></li>
            <li><a href="/revenue" class="nav-link">Revenue</a></li>
            <li><a href="/planner" class="nav-link">Planner</a></li>
        </ul>
    </nav>

    <div class="container">
        <% const farmersList = Array.isArray(farmers) ? farmers : []; %>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <div class="page-header">
            <h1><i class="fas fa-hard-hat"></i> Contractors</h1>
            <button class="btn btn-primary" onclick="toggleForm()">+ Register New Contractor</button>
        </div>

        <div id="contractorForm" class="form-container" style="display: none;">
            <h2>Register New Contractor</h2>
            <form method="POST" action="/contractors/create">
                <div class="form-group">
                    <label for="name">Company Name *</label>
                    <input type="text" id="name" name="name" required placeholder="Enter company name">
                </div>
                <div class="form-group">
                    <label for="contact">Contact Number *</label>
                    <input type="text" id="contact" name="contact" required placeholder="Enter contact number">
                </div>
                <div class="form-group">
                    <label for="region">Region *</label>
                    <input type="text" id="region" name="region" required placeholder="Enter service region">
                </div>
                <div class="form-group">
                    <label for="requiredAcreageHa">Min Acreage Required (Ha) *</label>
                    <input type="number" id="requiredAcreageHa" name="requiredAcreageHa" required step="0.1" placeholder="Enter minimum acreage">
                </div>
                <div class="form-group">
                    <label for="crops">Crops Handled (comma-separated) *</label>
                    <input type="text" id="crops" name="crops" required placeholder="e.g., Wheat, Rice, Maize">
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Register</button>
                    <button type="button" class="btn btn-secondary" onclick="toggleForm()">Cancel</button>
                </div>
            </form>
        </div>

        <div class="list-section">
            <h2><i class="fas fa-building"></i> Registered Contractors</h2>
            <% if (contractors && contractors.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
                    <% contractors.forEach(contractor => { %>
                        <div style="background: white; border-radius: 8px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.3s; cursor: pointer;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.15)'; this.style.transform='translateY(-5px)';" onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)'; this.style.transform='translateY(0)';">
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                                <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #2980b9, #3498db); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                                    <i class="fas fa-hard-hat"></i>
                                </div>
                                <h3 style="margin: 0; color: #2c3e50;"><%= contractor.name %></h3>
                            </div>
                            <div style="margin: 1rem 0; font-size: 0.95rem; color: #555;">
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-phone"></i> Contact:</strong> <%= contractor.contact || 'N/A' %></p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-map-marker-alt"></i> Region:</strong> <%= contractor.region || 'N/A' %></p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-field"></i> Min Acreage:</strong> <%= contractor.requiredAcreageHa || 'N/A' %> Ha</p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-leaf"></i> Crops:</strong> <%= contractor.crops ? contractor.crops.join(', ') : 'N/A' %></p>
                                <p style="margin: 0.5rem 0; font-size: 0.85rem; color: #7f8c8d;"><strong><i class="fas fa-calendar-alt"></i> Joined:</strong> <%= new Date(contractor.createdAt).toLocaleDateString() %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 3rem; background: #f8f9fa; border-radius: 8px; margin-top: 2rem;">
                    <i class="fas fa-inbox" style="font-size: 3rem; color: #bdc3c7; margin-bottom: 1rem;"></i>
                    <h3 style="color: #2c3e50;">No Contractors Registered Yet</h3>
                    <p style="color: #7f8c8d;">Be the first to register a contractor!</p>
                </div>
            <% } %>
        </div>

        <div class="list-section" style="margin-top: 3rem;">
            <h2><i class="fas fa-users"></i> Registered Farmers</h2>
            <% if (farmersList.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem;">
                    <% farmersList.forEach(farmer => { %>
                        <div style="background: white; border-radius: 8px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.3s; cursor: pointer;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.15)'; this.style.transform='translateY(-5px)';" onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)'; this.style.transform='translateY(0)';">
                            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                                <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #27ae60, #2ecc71); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h3 style="margin: 0; color: #2c3e50;"><%= farmer.name %></h3>
                            </div>
                            <div style="margin: 1rem 0; font-size: 0.95rem; color: #555;">
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-phone"></i> Contact:</strong> <%= farmer.contact || 'N/A' %></p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-map-marker-alt"></i> Location:</strong> <%= farmer.location || 'N/A' %></p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-field"></i> Acreage:</strong> <%= farmer.acreageHa || 'N/A' %> Ha</p>
                                <p style="margin: 0.5rem 0;"><strong><i class="fas fa-leaf"></i> Crops:</strong> <%= farmer.crops ? farmer.crops.join(', ') : 'N/A' %></p>
                                <p style="margin: 0.5rem 0; font-size: 0.85rem; color: #7f8c8d;"><strong><i class="fas fa-calendar-alt"></i> Joined:</strong> <%= new Date(farmer.createdAt).toLocaleDateString() %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 3rem; background: #f8f9fa; border-radius: 8px; margin-top: 2rem;">
                    <i class="fas fa-inbox" style="font-size: 3rem; color: #bdc3c7; margin-bottom: 1rem;"></i>
                    <h3 style="color: #2c3e50;">No Farmers Registered Yet</h3>
                    <p style="color: #7f8c8d;">Visit the <a href="/farmers" style="color: var(--primary-color);">Farmers portal</a> to see farmer registrations.</p>
                </div>
            <% } %>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2025 AgroVision - Agricultural Planning Platform</p>
    </footer>

    <script>
        function toggleForm() {
            const form = document.getElementById('contractorForm');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    </script>
</body>
</html>
