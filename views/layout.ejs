<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'AgroVision' %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <% if (typeof customCss !== 'undefined') { %>
        <link rel="stylesheet" href="<%= customCss %>">
    <% } %>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmers" class="nav-link">Farmers</a></li>
            <li><a href="/contractors" class="nav-link">Contractors</a></li>
            <li><a href="/revenue" class="nav-link">Revenue</a></li>
            <li><a href="/planner" class="nav-link">Planner</a></li>
        </ul>
    </nav>

    <div class="container">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <%- body %>
    </div>

    <footer class="footer">
        <p>&copy; 2025 AgroVision - Agricultural Planning Platform</p>
    </footer>
</body>
</html>
