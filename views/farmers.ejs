<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmers Portal - AgroVision</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    <style>
        .tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid #ecf0f1;
        }
        .tab-btn {
            background: none;
            border: none;
            padding: 1rem;
            cursor: pointer;
            font-size: 1rem;
            color: #7f8c8d;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }
        .tab-btn.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }

        /* Contractor Cards */
        .contractor-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .contractor-card {
            background-color: var(--white);
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition: all 0.3s;
        }

        .contractor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        .contractor-card-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .contractor-avatar {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
        }

        .contractor-card h3 {
            margin: 0;
            color: var(--text-color);
            font-size: 1.1rem;
        }

        .contractor-card-info {
            margin: 1rem 0;
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .contractor-card-info p {
            margin: 0.5rem 0;
        }

        .contractor-card-footer {
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid #ecf0f1;
            display: flex;
            gap: 0.5rem;
        }

        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            flex: 1;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            overflow-y: auto;
        }

        .modal.active {
            display: block;
        }

        .modal-content {
            background-color: var(--white);
            margin: 2% auto;
            padding: 2rem;
            border-radius: 8px;
            width: 90%;
            max-width: 700px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #ecf0f1;
        }

        .modal-header h2 {
            margin: 0;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 2rem;
            cursor: pointer;
            color: #7f8c8d;
        }

        .contractor-details {
            background-color: #f8f9fa;
            padding: 1.5rem;
            border-radius: 4px;
            margin-bottom: 1.5rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #ecf0f1;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            font-weight: 600;
            color: var(--text-color);
        }

        .detail-value {
            color: #7f8c8d;
        }

        .contract-document {
            background-color: #f8f9fa;
            padding: 2rem;
            border-radius: 4px;
            margin-bottom: 1.5rem;
            border: 1px solid #e0e0e0;
            font-size: 0.95rem;
            line-height: 1.8;
        }

        .contract-document h4 {
            margin-top: 1rem;
            color: var(--text-color);
        }

        .signature-section {
            margin-top: 2rem;
            padding: 1.5rem;
            background-color: #f8f9fa;
            border-radius: 4px;
        }

        .signature-date {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1rem;
        }

        .empty-state {
            text-align: center;
            color: #7f8c8d;
            padding: 3rem;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-brand">
            <a href="/" class="logo">
                <i class="fas fa-leaf"></i> AgroVision
            </a>
        </div>
        <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/farmers" class="nav-link active">Farmers</a></li>
            <li><a href="/contractors" class="nav-link">Contractors</a></li>
            <li><a href="/revenue" class="nav-link">Revenue</a></li>
            <li><a href="/planner" class="nav-link">Planner</a></li>
        </ul>
    </nav>

    <div class="container">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> <%= message %>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <div class="page-header">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <div>
                    <h1><i class="fas fa-handshake"></i> Farmer Portal</h1>
                    <p>Browse contractors and sign service contracts</p>
                </div>
                <button class="btn btn-success" onclick="openFarmerRegistrationModal()" style="white-space: nowrap; margin-left: 2rem;">
                    <i class="fas fa-user-plus"></i> Register New Farmer
                </button>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab(event, 'contractors-tab')">
                <i class="fas fa-building"></i> Find Contractors
            </button>
            <button class="tab-btn" onclick="switchTab(event, 'revenue-tab')">
                <i class="fas fa-chart-line"></i> Revenue Calculator
            </button>
            <button class="tab-btn" onclick="switchTab(event, 'planner-tab')">
                <i class="fas fa-calendar-alt"></i> Crop Planner
            </button>
        </div>

        <!-- CONTRACTORS TAB -->
        <div id="contractors-tab" class="tab-content active">
            <h2 style="margin-bottom: 1rem;">Available Contractors</h2>

            <% if (contractors && contractors.length > 0) { %>
                <div class="contractor-grid">
                    <% contractors.forEach(contractor => { %>
                        <div class="contractor-card" onclick="openContractModal(<%= JSON.stringify(contractor).replace(/'/g, '&#39;') %>)">
                            <div class="contractor-card-header">
                                <div class="contractor-avatar">
                                    <i class="fas fa-hard-hat"></i>
                                </div>
                                <h3><%= contractor.name %></h3>
                            </div>
                            <div class="contractor-card-info">
                                <p><strong><i class="fas fa-phone"></i></strong> <%= contractor.contact || 'N/A' %></p>
                                <p><strong><i class="fas fa-map-marker-alt"></i></strong> <%= contractor.region || 'N/A' %></p>
                                <p><strong><i class="fas fa-field"></i></strong> Min <%= contractor.requiredAcreageHa || 'N/A' %> Ha</p>
                            </div>
                            <div class="contractor-card-info">
                                <p><strong>Crops:</strong> <%= contractor.crops ? contractor.crops.join(', ') : 'N/A' %></p>
                            </div>
                            <div class="contractor-card-footer">
                                <button class="btn btn-primary btn-sm" onclick="openContractModal(event, '<%= contractor._id %>')">
                                    <i class="fas fa-file-contract"></i> View Contract
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-inbox" style="font-size: 3rem; color: #bdc3c7; margin-bottom: 1rem;"></i>
                    <h3>No Contractors Available</h3>
                    <p>Check back later or visit the <a href="/contractors">Contractors page</a> to see all registered contractors.</p>
                </div>
            <% } %>
        </div>

        <!-- REVENUE CALCULATOR TAB -->
        <div id="revenue-tab" class="tab-content">
            <div class="calculator-section">
                <div class="calc-container">
                    <h3>Revenue Calculator</h3>
                    <p style="color: #7f8c8d; margin-bottom: 1.5rem;">Estimate your crop revenue based on field parameters</p>
                    <form method="POST" action="/farmers/calculate-revenue" id="revenueForm">
                        <div class="form-group">
                            <label for="fieldSizeHa">Field Size (Hectares) *</label>
                            <input type="number" id="fieldSizeHa" name="fieldSizeHa" required step="0.1" placeholder="Enter field size in hectares" min="0">
                        </div>

                        <div class="form-group">
                            <label for="cropType">Crop Type *</label>
                            <select id="cropType" name="cropType" required>
                                <option value="">-- Select Crop --</option>
                                <option value="Wheat">Wheat</option>
                                <option value="Rice">Rice</option>
                                <option value="Maize">Maize</option>
                                <option value="Cotton">Cotton</option>
                                <option value="Sugarcane">Sugarcane</option>
                                <option value="Groundnut">Groundnut</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="season">Season *</label>
                            <select id="season" name="season" required>
                                <option value="">-- Select Season --</option>
                                <option value="Rabi">Rabi (Winter)</option>
                                <option value="Kharif">Kharif (Monsoon)</option>
                                <option value="Summer">Summer</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="soilQuality">Soil Quality (1-10) *</label>
                            <input type="number" id="soilQuality" name="soilQuality" required min="1" max="10" placeholder="Enter soil quality rating">
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg">Calculate Revenue</button>
                    </form>
                </div>

                <% if (typeof result !== 'undefined' && result) { %>
                    <div class="result-card">
                        <h3>Revenue Estimate</h3>
                        <div class="result-grid">
                            <div class="result-item">
                                <label>Estimated Yield</label>
                                <p class="result-value"><%= result.estimatedYield.toFixed(2) %> <span class="unit">tonnes</span></p>
                            </div>
                            <div class="result-item">
                                <label>Minimum Support Price (MSP)</label>
                                <p class="result-value">₹<%= result.msp.toLocaleString() %> <span class="unit">per tonne</span></p>
                            </div>
                            <div class="result-item">
                                <label>Estimated Revenue</label>
                                <p class="result-value highlight">₹<%= result.revenue.toLocaleString('en-IN', {maximumFractionDigits: 0}) %></p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- CROP PLANNER TAB -->
        <div id="planner-tab" class="tab-content">
            <div class="planner-section">
                <div class="planner-container">
                    <h3>Crop Planner</h3>
                    <p style="color: #7f8c8d; margin-bottom: 1.5rem;">Get a detailed schedule for your crop planning</p>
                    <form method="POST" action="/farmers/generate-plan" id="plannerForm">
                        <div class="form-group">
                            <label for="plannerCropType">Crop Type *</label>
                            <select id="plannerCropType" name="cropType" required>
                                <option value="">-- Select Crop --</option>
                                <option value="Wheat">Wheat</option>
                                <option value="Rice">Rice</option>
                                <option value="Maize">Maize</option>
                                <option value="Cotton">Cotton</option>
                                <option value="Sugarcane">Sugarcane</option>
                                <option value="Groundnut">Groundnut</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="sowingDate">Sowing Date *</label>
                            <input type="date" id="sowingDate" name="sowingDate" required>
                        </div>

                        <div class="form-group">
                            <label for="duration">Expected Duration (Days) *</label>
                            <input type="number" id="duration" name="duration" required min="30" placeholder="Enter crop duration in days">
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg">Generate Plan</button>
                    </form>
                </div>

                <% if (typeof schedule !== 'undefined' && schedule && schedule.length > 0) { %>
                    <div class="schedule-card">
                        <h3>Crop Schedule</h3>
                        <div class="timeline">
                            <% schedule.forEach((event, index) => { %>
                                <div class="timeline-item">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <h4 style="margin: 0 0 0.5rem 0;"><%= event.activity %></h4>
                                        <p style="margin: 0.25rem 0;"><strong>Date:</strong> <%= event.date %></p>
                                        <p style="margin: 0.25rem 0;"><strong>Day:</strong> <%= event.day %></p>
                                        <% if (event.notes) { %>
                                            <p style="margin: 0.25rem 0;"><strong>Notes:</strong> <%= event.notes %></p>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- CONTRACT MODAL -->
    <div id="contractModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Service Contract</h2>
                <button class="modal-close" onclick="closeContractModal()">&times;</button>
            </div>

            <div id="contractBody">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>

    <!-- Farmer Registration Modal -->
    <div id="farmerRegistrationModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-user-plus"></i> Register New Farmer</h2>
                <button class="modal-close" onclick="closeFarmerRegistrationModal()">&times;</button>
            </div>
            <form method="POST" action="/farmers/create" id="farmerRegistrationForm">
                <div class="form-group">
                    <label for="farmerName">Full Name *</label>
                    <input type="text" id="farmerName" name="name" required placeholder="Enter your full name">
                </div>

                <div class="form-group">
                    <label for="farmerContact">Contact Number *</label>
                    <input type="tel" id="farmerContact" name="contact" required placeholder="Enter your phone number">
                </div>

                <div class="form-group">
                    <label for="farmerLocation">Location/Village *</label>
                    <input type="text" id="farmerLocation" name="location" required placeholder="Enter your location or village name">
                </div>

                <div class="form-group">
                    <label for="farmerAcreage">Farm Size (Hectares) *</label>
                    <input type="number" id="farmerAcreage" name="acreageHa" required step="0.1" min="0" placeholder="Enter farm size in hectares">
                </div>

                <div class="form-group">
                    <label for="farmerCrops">Crops Grown (comma-separated) *</label>
                    <input type="text" id="farmerCrops" name="crops" required placeholder="e.g., Wheat, Rice, Maize">
                </div>

                <div class="form-actions" style="margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        <i class="fas fa-check-circle"></i> Register
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="closeFarmerRegistrationModal()" style="flex: 1;">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2025 AgroVision - Agricultural Planning Platform</p>
    </footer>

    <script>
        function switchTab(event, tabName) {
            // Hide all tabs
            const tabs = document.querySelectorAll('.tab-content');
            tabs.forEach(tab => tab.classList.remove('active'));

            // Remove active class from all buttons
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => btn.classList.remove('active'));

            // Show selected tab
            document.getElementById(tabName).classList.add('active');
            event.target.closest('.tab-btn').classList.add('active');

            // Store active tab in URL
            window.history.pushState({}, '', `/farmers?tab=${tabName}`);
        }

        function openContractModal(contractor) {
            const modal = document.getElementById('contractModal');
            const contractBody = document.getElementById('contractBody');

            const contractHTML = `
                <div class="contractor-details">
                    <h3>${contractor.name}</h3>
                    <div class="detail-row">
                        <span class="detail-label">Contact:</span>
                        <span class="detail-value">${contractor.contact || 'N/A'}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Region:</span>
                        <span class="detail-value">${contractor.region || 'N/A'}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Min Acreage Required:</span>
                        <span class="detail-value">${contractor.requiredAcreageHa || 'N/A'} Ha</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Crops Handled:</span>
                        <span class="detail-value">${contractor.crops ? contractor.crops.join(', ') : 'N/A'}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Joined:</span>
                        <span class="detail-value">${new Date(contractor.createdAt).toLocaleDateString()}</span>
                    </div>
                </div>

                <div class="contract-document">
                    <h4>SERVICE AGREEMENT</h4>
                    <p><strong>This Service Agreement ("Agreement") is entered into as of ${new Date().toLocaleDateString()}, between:</strong></p>

                    <p><strong>Service Provider:</strong> ${contractor.name} (hereinafter referred to as "Contractor")</p>
                    <p><strong>Service Recipient:</strong> The Farmer (hereinafter referred to as "Farmer")</p>

                    <h4>Terms and Conditions</h4>
                    <p><strong>1. Services:</strong> Contractor agrees to provide agricultural services for crops including: ${contractor.crops ? contractor.crops.join(', ') : 'All crops'}.</p>

                    <p><strong>2. Minimum Farm Size:</strong> This service is available for farms with a minimum of ${contractor.requiredAcreageHa} hectares.</p>

                    <p><strong>3. Service Area:</strong> Services are provided in the ${contractor.region} region.</p>

                    <p><strong>4. Payment Terms:</strong> Payment terms will be mutually agreed upon between the parties.</p>

                    <p><strong>5. Duration:</strong> This agreement remains valid for one agricultural season unless terminated by either party with 30 days written notice.</p>

                    <p><strong>6. Responsibilities:</strong> Contractor will provide professional agricultural services as per industry standards. Farmer will provide necessary access to farmland and cooperate with service delivery.</p>

                    <p><strong>7. Dispute Resolution:</strong> Any disputes shall be resolved through mutual negotiation or local agricultural authority.</p>

                    <p><strong>By signing below, both parties agree to the terms and conditions stated in this Service Agreement.</strong></p>
                </div>

                <form method="POST" action="/farmers/sign-contract" class="signature-section">
                    <div class="form-group">
                        <label for="farmerName">Your Name (Farmer) *</label>
                        <input type="text" id="farmerName" name="farmerName" required placeholder="Enter your name">
                    </div>

                    <div class="form-group">
                        <label for="farmerContact">Your Contact *</label>
                        <input type="text" id="farmerContact" name="farmerContact" required placeholder="Enter your contact number">
                    </div>

                    <div class="form-group">
                        <label for="farmerLocation">Your Location *</label>
                        <input type="text" id="farmerLocation" name="farmerLocation" required placeholder="Enter your location">
                    </div>

                    <div class="form-group">
                        <label for="farmAcreage">Farm Acreage (Ha) *</label>
                        <input type="number" id="farmAcreage" name="farmAcreage" required step="0.1" placeholder="Enter your farm size">
                    </div>

                    <div class="signature-date">
                        <div class="form-group">
                            <label for="signatureDate">Signature Date *</label>
                            <input type="date" id="signatureDate" name="signatureDate" required>
                        </div>
                        <div class="form-group">
                            <label for="signature">Your Signature/Initials *</label>
                            <input type="text" id="signature" name="signature" required placeholder="E.g., JD">
                        </div>
                    </div>

                    <input type="hidden" name="contractorId" value="${contractor._id}">
                    <input type="hidden" name="contractorName" value="${contractor.name}">

                    <div class="form-actions" style="margin-top: 2rem;">
                        <button type="submit" class="btn btn-primary" style="flex: 1;">
                            <i class="fas fa-pen-fancy"></i> Sign Contract
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="closeContractModal()" style="flex: 1;">Cancel</button>
                    </div>
                </form>
            `;

            contractBody.innerHTML = contractHTML;
            modal.classList.add('active');
        }

        function closeContractModal() {
            document.getElementById('contractModal').classList.remove('active');
        }

        function openFarmerRegistrationModal() {
            document.getElementById('farmerRegistrationModal').classList.add('active');
        }

        function closeFarmerRegistrationModal() {
            document.getElementById('farmerRegistrationModal').classList.remove('active');
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const contractModal = document.getElementById('contractModal');
            const farmerModal = document.getElementById('farmerRegistrationModal');
            if (event.target == contractModal) {
                contractModal.classList.remove('active');
            }
            if (event.target == farmerModal) {
                farmerModal.classList.remove('active');
            }
        }

        // Handle tab from URL on page load
        window.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            const activeTab = params.get('tab') || 'contractors-tab';
            const tabElement = document.getElementById(activeTab);
            const buttons = document.querySelectorAll('.tab-btn');

            if (tabElement) {
                document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
                tabElement.classList.add('active');
                buttons.forEach(btn => btn.classList.remove('active'));
                buttons.forEach(btn => {
                    if (btn.getAttribute('onclick').includes(activeTab)) {
                        btn.classList.add('active');
                    }
                });
            }

            // Auto-switch to revenue tab if result is shown
            const resultCard = document.querySelector('.result-card');
            const scheduleCard = document.querySelector('.schedule-card');

            if (resultCard) {
                const params = new URLSearchParams(window.location.search);
                params.set('tab', 'revenue-tab');
                window.history.replaceState({}, '', `/farmers?${params.toString()}`);

                document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
                document.getElementById('revenue-tab').classList.add('active');
                document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
            }

            if (scheduleCard) {
                const params = new URLSearchParams(window.location.search);
                params.set('tab', 'planner-tab');
                window.history.replaceState({}, '', `/farmers?${params.toString()}`);

                document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
                document.getElementById('planner-tab').classList.add('active');
                document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                document.querySelectorAll('.tab-btn')[2].classList.add('active');
            }
        });
    </script>
</body>
</html>

