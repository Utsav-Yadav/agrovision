# MongoDB Connection
# For local development:
# MONGODB_URI=mongodb://localhost:27017/agrovision

# For MongoDB Atlas (free tier, recommended for production):
# Get connection string from MongoDB Atlas and replace username/password
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/agrovision?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# Production Deployment
# When deploying to Render/Railway:
# 1. Set NODE_ENV=production
# 2. Set MONGODB_URI to your MongoDB Atlas connection string
# 3. Server will automatically use PORT from environment
